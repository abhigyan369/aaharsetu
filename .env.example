# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template for environment variables
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the real values in .env
#   3. .env is in .gitignore — never commit it!  This file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development             # "development" | "production"
APP_NAME="Food Waste Redistribution Platform"
DEBUG=true                      # Set to false in production
CORS_ORIGINS="*"                # Comma-separated allowed origins (e.g. "https://my-app.onrender.com")

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# asyncpg is the async PostgreSQL driver; SQLAlchemy uses it behind the scenes.
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/food_waste_db

# ── JWT (JSON Web Token) ──────────────────────────────────────────────────────
# SECRET_KEY: A long random string used to sign tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this key leaks, anyone can forge tokens — keep it secret!
SECRET_KEY=changeme_use_a_long_random_string_here
ALGORITHM=HS256                 # Signing algorithm — HS256 is standard for most apps
ACCESS_TOKEN_EXPIRE_MINUTES=30  # Tokens expire after this many minutes

# ── Email / Notifications (Phase 4) ──────────────────────────────────────────
#
# EMAILS_ENABLED=false means the app skips sending emails (no SMTP errors in
# local dev). Notification rows are ALWAYS written to the DB regardless.
# Set to true only when you have valid SMTP credentials.
EMAILS_ENABLED=false
EMAILS_FROM_NAME="Food Waste Platform"
EMAILS_FROM_EMAIL=noreply@foodwaste.example.com
#
# ── Option A: Mailtrap (recommended for local dev) ────────────────────────────
# Mailtrap is a free sandbox — it accepts all outgoing mail but never delivers
# it to real inboxes. Sign up at https://mailtrap.io → Inboxes → SMTP Settings.
# Copy the credentials they give you into the fields below.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USE_TLS=true          # STARTTLS on port 587; set false if using SSL/port 465
SMTP_USER=your_mailtrap_username_here
SMTP_PASSWORD=your_mailtrap_password_here
#
# ── Option B: Gmail (dev, if you prefer) ──────────────────────────────────────
# Use an App Password (not your real password). Enable 2FA first, then:
#   Google Account → Security → App Passwords → create one → paste below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
#
# ── Option C: Production — SendGrid ───────────────────────────────────────────
# No code changes needed — just swap these .env values on your hosting platform.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=apikey                    # literally the string "apikey"
# SMTP_PASSWORD=SG.your_sendgrid_api_key
#
# ── Option D: Production — Resend ─────────────────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USE_TLS=false                  # Resend uses implicit SSL on 465
# SMTP_USER=resend                    # literally the string "resend"
# SMTP_PASSWORD=re_your_resend_api_key

# ── Cloudinary (Phase 5 — Image Upload) ───────────────────────────────────────
#
# WHY CLOUDINARY (not local disk, not Postgres)?
#   Local disk — Render/Railway use ephemeral filesystems: every redeploy wipes
#     the disk. Even on a persistent VM, two server instances don't share a disk.
#   Postgres bytea — binary blobs bloat the DB, slow down queries, and can't
#     leverage a CDN. The DB is for structured relational data, not raw files.
#   Cloudinary — images live on a global CDN; your DB just stores a URL string.
#     Free tier: 25 GB storage + 25 GB bandwidth/month — plenty for a portfolio.
#
# SETUP (one-time, takes ~3 minutes):
#   1. Go to https://cloudinary.com → Sign Up Free (no credit card needed)
#   2. After login, your Cloud Name appears top-left on the dashboard.
#      Copy it into CLOUDINARY_CLOUD_NAME below.
#   3. Click the ⚙ Settings icon → "API Keys" tab.
#      You'll see an API Key and an API Secret row.
#      Copy both. Treat the Secret like a password — never commit it to git.
#   4. Fill in the three values below and save .env.
#   5. On Render / Railway: go to your service → Environment → add the same
#      three variables there. The platform injects them at runtime.
#
# CLOUDINARY_UPLOAD_FOLDER: images are organised into this sub-folder inside
#   your Cloudinary media library. Default is "food_waste". You can change it,
#   but it doesn't affect functionality — just dashboard organisation.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_UPLOAD_FOLDER=food_waste
