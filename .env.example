# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template for environment variables
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the real values in .env
#   3. .env is in .gitignore — never commit it!  This file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development             # "development" | "production"
APP_NAME="Food Waste Redistribution Platform"
DEBUG=true                      # Set to false in production

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# asyncpg is the async PostgreSQL driver; SQLAlchemy uses it behind the scenes.
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/food_waste_db

# ── JWT (JSON Web Token) ──────────────────────────────────────────────────────
# SECRET_KEY: A long random string used to sign tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this key leaks, anyone can forge tokens — keep it secret!
SECRET_KEY=changeme_use_a_long_random_string_here
ALGORITHM=HS256                 # Signing algorithm — HS256 is standard for most apps
ACCESS_TOKEN_EXPIRE_MINUTES=30  # Tokens expire after this many minutes

# ── Email (Phase 5) ───────────────────────────────────────────────────────────
# Leave blank for now; fill in when you implement notifications.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@foodwaste.example.com

# ── Cloudinary (Phase 6 — Image Upload) ───────────────────────────────────────
# Leave blank for now; fill in when you implement image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
